prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "diff", "--"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["rg", "--files"], decision="allow")
prefix_rule(pattern=["pnpm", "lint"], decision="allow")
prefix_rule(pattern=["pnpm", "build"], decision="allow")
prefix_rule(pattern=["pnpm", "exec", "tsc", "--noEmit"], decision="allow")
prefix_rule(pattern=["pnpm", "exec", "eslint", "."], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\cmd.exe", "/c", "pnpm lint"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\cmd.exe", "/c", "pnpm build"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\cmd.exe", "/c", "pnpm exec tsc --noEmit"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\cmd.exe", "/c", "pnpm exec eslint ."], decision="allow")
