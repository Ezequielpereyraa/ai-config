{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{env:USERPROFILE}/ai-config/CORE.md",
    "{env:USERPROFILE}/ai-config/WORKFLOW.md"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "share": "manual",
  "autoupdate": "notify",
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**"
    ]
  },
  "plugin": ["@warp-dot-dev/opencode-warp"]
}
